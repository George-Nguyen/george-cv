---
export interface Props {
  email: string;
  phone: string;
  telegram: string;
  linkedin: string;
}
const { email, phone, telegram, linkedin } = Astro.props;
---
<section id="contact" class="py-section-mobile md:py-section bg-primary">
  <div class="max-w-content mx-auto px-6 text-center">
    <span class="text-label-caps text-on-primary opacity-60 uppercase tracking-widest block mb-6">Get in Touch</span>
    <h2 class="text-headline-md text-on-primary mb-10">Connect for Strategic Partnerships</h2>
    <div class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-12">
      <a href={`mailto:${email}`} class="flex items-center gap-3 text-on-primary opacity-80 hover:opacity-100 transition-opacity duration-200">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
        <span class="text-body-md">{email}</span>
      </a>
      <a href={`tel:${phone}`} class="flex items-center gap-3 text-on-primary opacity-80 hover:opacity-100 transition-opacity duration-200">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.61 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span class="text-body-md">{phone}</span>
      </a>
      {telegram && (
        <span class="flex items-center gap-3 text-on-primary opacity-80">
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.447 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.12L7.922 14.45l-2.96-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.194 1.006.131.826.109z"/>
          </svg>
          <span class="text-body-md">{telegram}</span>
        </span>
      )}
      {linkedin && linkedin !== 'https://linkedin.com/in/georgenguyen' && (
        <a href={linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-on-primary opacity-80 hover:opacity-100 transition-opacity duration-200">
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          <span class="text-body-md">LinkedIn</span>
        </a>
      )}
    </div>
  </div>
</section>
