---
export interface Props {
  name: string;
  pdfUrl: string;
  layout?: string;
}
const { name, pdfUrl, layout } = Astro.props;
const isAiGm = layout === 'ai-gm';
---
<header class="sticky top-0 z-50 bg-surface-container-low border-b border-outline-variant">
  <div class="max-w-content mx-auto px-6 h-16 flex items-center justify-between">
    <span class="text-primary font-bold text-sm tracking-widest uppercase">{name}</span>
    <nav class="hidden md:flex items-center gap-8">
      <a href="#about" class="nav-link">About</a>
      <a href="#experience" class="nav-link">Experience</a>
      <a href={isAiGm ? '#achievements' : '#projects'} class="nav-link">{isAiGm ? 'Achievements' : 'Projects'}</a>
      <a href="#skills" class="nav-link">Skills</a>
      <a href="#contact" class="nav-link">Contact</a>
      <a href={pdfUrl} download class="btn-primary text-xs py-2 px-4">Let's Talk</a>
    </nav>
    <!-- Mobile menu toggle -->
    <button id="menu-toggle" class="md:hidden text-on-surface" aria-label="Toggle menu">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>
  <!-- Mobile nav -->
  <div id="mobile-menu" class="hidden md:hidden bg-surface-container-low border-t border-outline-variant px-6 py-4 flex flex-col gap-4">
    <a href="#about" class="nav-link">About</a>
    <a href="#experience" class="nav-link">Experience</a>
    <a href="#skills" class="nav-link">Skills</a>
    <a href="#projects" class="nav-link">Projects</a>
    <a href="#contact" class="nav-link">Contact</a>
    <a href={pdfUrl} download class="btn-primary text-xs py-2 px-4 self-start">Let's Talk</a>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => menu.classList.add('hidden')));
</script>
