---
export interface Props {
  role: string;
  company: string;
  dates: string;
  bullets: string[];
}
const { role, company, dates, bullets } = Astro.props;
---
<div class="border-l-4 border-primary-container bg-white p-8 shadow-md mb-12">
  <span class="bg-primary text-white text-label-caps px-3 py-1 inline-block mb-4">Current Role</span>
  <div class="flex items-start justify-between gap-4 flex-wrap mb-6">
    <div>
      <h3 class="text-headline-sm text-on-surface font-semibold">{role}</h3>
      <p class="text-label-caps text-secondary uppercase tracking-widest mt-1">{company}</p>
    </div>
    <span class="text-label-caps text-on-surface-variant bg-surface-container-low px-3 py-1 whitespace-nowrap">{dates}</span>
  </div>
  <ul class="space-y-3">
    {bullets.map((b) => (
      <li class="flex gap-3 text-body-md text-on-surface-variant">
        <span class="mt-2 w-1.5 h-1.5 bg-primary flex-shrink-0"></span>
        <span>{b}</span>
      </li>
    ))}
  </ul>
</div>
